# Copy to .env next to docker-compose.prod.yml and adjust.
# PostgreSQL only applies these on first start (empty volume). To change the
# password of an existing database, run ALTER USER inside the container first.
POSTGRES_USER=milkrun
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Images published by .github/workflows/deploy.yml
MILKRUN_IMAGE_REGISTRY=ghcr.io/marwan-eid
MILKRUN_IMAGE_TAG=latest
