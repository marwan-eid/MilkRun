<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Dev: human-readable console lines. prod profile: one JSON object per line. -->

    <!-- Application loggers -->
    <logger name="com.milkrun" level="DEBUG" />
    <logger name="com.milkrun.pipeline" level="INFO" />
    <logger name="com.milkrun.consumer" level="INFO" />

    <!-- Framework loggers (reduce noise) -->
    <logger name="reactor.kafka" level="WARN" />
    <logger name="org.apache.kafka" level="WARN" />
    <logger name="org.apache.calcite" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="io.r2dbc" level="WARN" />

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
                <withFormattedMessage>true</withFormattedMessage>
                <withMessage>false</withMessage>
                <withArguments>false</withArguments>
                <withContext>false</withContext>
                <withSequenceNumber>false</withSequenceNumber>
                <withNanoseconds>false</withNanoseconds>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON" />
        </root>
    </springProfile>
</configuration>
